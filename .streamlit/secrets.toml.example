# Copy this file to .streamlit/secrets.toml and put your real key there.
# secrets.toml is in .gitignore, so the key never reaches GitHub.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-key-here"

# Optional: comma-separated Gemini models, tried in order when one is overloaded or out of quota
# GEMINI_MODEL = "gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest"
